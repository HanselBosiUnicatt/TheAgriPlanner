function renderCashflow(r){const entr=Array(12).fill(0),usc=Array(12).fill(0),mr=num('meseRicavi')-1,mc=num('meseCostiGrossi')-1;entr[mr]+=r.ricavi*num('incassoSubitoPct')/100;entr[(mr+1)%12]+=r.ricavi*(1-num('incassoSubitoPct')/100);usc[mc]+=r.costi*num('costiConcentratiPct')/100;const rest=r.costi*(1-num('costiConcentratiPct')/100)/12;for(let i=0;i<12;i++)usc[i]+=rest;let cum=0;document.getElementById('tabCashflow').innerHTML=['Gen','Feb','Mar','Apr','Mag','Giu','Lug','Ago','Set','Ott','Nov','Dic'].map((m,i)=>{const s=entr[i]-usc[i];cum+=s;return `<tr><td>${m}</td><td>${euro(entr[i])}</td><td>${euro(usc[i])}</td><td class="${s>=0?'positive':'negative'}">${euro(s)}</td><td class="${cum>=0?'positive':'negative'}">${euro(cum)}</td></tr>`}).join('')}
