function renderStressTests(){const base=compute();
  const tests=[
    ['Base',{}],['Fieno +30%',{prezzoBallone:num('prezzoBallone')*1.3}],['Ricavi -20%',{ricavoBovino:num('ricavoBovino')*.8,prezzoColturaT:num('prezzoColturaT')*.8,prezzoFruttoQ:num('prezzoFruttoQ')*.8,prezzoEnergiaMWh:num('prezzoEnergiaMWh')*.8}],['Costi colture/frutteto +25%',{costiColturaHa:num('costiColturaHa')*1.25,costiFruttoHa:num('costiFruttoHa')*1.25}],['Rese colture/frutti -35%',{resaColturaTHa:num('resaColturaTHa')*.65,resaFruttoQHa:num('resaFruttoQHa')*.65}],['Mortalità/scarti +5 punti',{mortalitaBoviniPct:num('mortalitaBoviniPct')+5,scartoFruttoPct:num('scartoFruttoPct')+5}],['Scenario ottimistico',{ricavoBovino:num('ricavoBovino')*1.15,prezzoBallone:num('prezzoBallone')*.9,resaColturaTHa:num('resaColturaTHa')*1.1,resaFruttoQHa:num('resaFruttoQHa')*1.1}]
  ];
  const rows=tests.map(([name,ov])=>[name,compute(ov)]); const worst=rows.reduce((a,b)=>b[1].netto<a[1].netto?b:a,rows[0]); const best=rows.reduce((a,b)=>b[1].netto>a[1].netto?b:a,rows[0]);
  const score=Math.max(0,Math.min(100,Math.round(50+(base.netto/(Math.max(base.ricavi,1))*120)-(base.ubaHa>1.4?12:0)-(base.payback>8?12:0)-(worst[1].netto<0?18:0))));
  const sc=document.getElementById('riskScore'); if(sc){sc.textContent=score; sc.className='score '+(score>=70?'good':score>=45?'mid':'bad');}
  if(document.getElementById('riskScoreText'))document.getElementById('riskScoreText').textContent=score>=70?'solido':score>=45?'da migliorare':'fragile';if(document.getElementById('topScore')){document.getElementById('topScore').textContent=score+'/100';document.getElementById('topScore').className=score>=70?'positive':score>=45?'warning':'negative';}
  if(document.getElementById('worstScenario'))document.getElementById('worstScenario').textContent=euro(worst[1].netto);
  if(document.getElementById('bestScenario'))document.getElementById('bestScenario').textContent=euro(best[1].netto);
  const feed=compute({prezzoBallone:num('prezzoBallone')*1.3}).netto-base.netto; if(document.getElementById('feedSensitivity'))document.getElementById('feedSensitivity').textContent=euro(feed);
  if(document.getElementById('cashBuffer'))document.getElementById('cashBuffer').textContent=euro(Math.max(base.costi*.20,Math.abs(worst[1].netto-base.netto)));
  if(document.getElementById('tabStress'))document.getElementById('tabStress').innerHTML=rows.map(([n,r])=>`<tr><td>${n}</td><td>${euro(r.ricavi)}</td><td>${euro(r.costi)}</td><td class="${r.netto>=0?'positive':'negative'}">${euro(r.netto)}</td><td class="${r.netto-base.netto>=0?'positive':'negative'}">${euro(r.netto-base.netto)}</td></tr>`).join('');
  const risks=[]; if(base.ubaHa>1.4)risks.push('Carico animale alto.'); if(base.kgNHa>num('limiteNHa'))risks.push('Azoto/ha oltre limite impostato.'); if(base.balloni>250)risks.push('Dipendenza elevata da fieno acquistato.'); if(base.payback>8)risks.push('Rientro investimento lento.'); if(worst[1].netto<0)risks.push('Lo scenario peggiore porta perdita.'); if(base.margine/base.ricavi<.15)risks.push('Margine operativo sottile.');
  if(document.getElementById('riskMap'))document.getElementById('riskMap').textContent=risks.length?risks.join(' '):'Profilo rischio buono con i valori attuali.';
}
