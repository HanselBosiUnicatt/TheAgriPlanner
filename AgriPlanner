function renderScenariAuto(){const base=compute(), up=compute({ricavoBovino:num('ricavoBovino')*1.2,prezzoColturaT:num('prezzoColturaT')*1.2,prezzoFruttoQ:num('prezzoFruttoQ')*1.2}), cost=compute({prezzoBallone:num('prezzoBallone')*1.2,costiColturaHa:num('costiColturaHa')*1.2,costiFruttoHa:num('costiFruttoHa')*1.2}), less=compute({boviniVenduti:Math.max(0,num('boviniVenduti')*.75)}), fruit=compute({haFruttetoCalc:num('haFruttetoCalc')+1}); const arr=[['Base',base],['+20% prezzi vendita',up],['+20% costi chiave',cost],['-25% bovini',less],['+1 ha frutteto',fruit]];document.getElementById('tabScenarioAuto').innerHTML=arr.map(([n,r])=>`<tr><td>${n}</td><td>${euro(r.ricavi)}</td><td>${euro(r.costi)}</td><td class="${r.netto>=0?'positive':'negative'}">${euro(r.netto)}</td><td>${isFinite(r.payback)?r.payback.toFixed(1)+' anni':'-'}</td></tr>`).join('')}
function salvaScenario(){const name=val('scenarioName')||val('nomeScenario')||'Scenario';const all=JSON.parse(localStorage.getItem('agriPlannerScenarios')||'{}');all[name]=capture();localStorage.setItem('agriPlannerScenarios',JSON.stringify(all));renderScenarioList()}
function caricaScenario(n){const all=JSON.parse(localStorage.getItem('agriPlannerScenarios')||'{}');if(all[n])apply(all[n])}function eliminaScenario(n){const all=JSON.parse(localStorage.getItem('agriPlannerScenarios')||'{}');delete all[n];localStorage.setItem('agriPlannerScenarios',JSON.stringify(all));renderScenarioList()}
function safeScenarioName(name){return encodeURIComponent(String(name))}
function caricaScenarioSafe(encodedName){caricaScenario(decodeURIComponent(encodedName))}
function eliminaScenarioSafe(encodedName){eliminaScenario(decodeURIComponent(encodedName))}
function renderScenarioList(){
  const box=document.getElementById('scenarioList');
  if(!box)return;
  const all=JSON.parse(localStorage.getItem('agriPlannerScenarios')||'{}');
  const names=Object.keys(all);
  if(!names.length){box.innerHTML='<span class="hint">Nessuno scenario salvato.</span>';return;}
  box.innerHTML=names.map(function(n){
    const safe=safeScenarioName(n);
    return '<span class="chip" onclick="caricaScenarioSafe(\''+safe+'\')">'+n+'</span><span class="chip" onclick="eliminaScenarioSafe(\''+safe+'\')">elimina</span>';
  }).join('');
}
function esportaJSON(){const blob=new Blob([JSON.stringify(capture(),null,2)],{type:'application/json'});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=(val('scenarioName')||'scenario')+'.json';a.click()}function importaJSON(e){const f=e.target.files[0];if(!f)return;const rd=new FileReader();rd.onload=()=>{try{apply(JSON.parse(rd.result))}catch(err){alert('JSON non valido')}};rd.readAsText(f)}
