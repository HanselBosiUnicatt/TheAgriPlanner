<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AgriPlanner Pro - Simulatore Agricolo Modulare</title>
  <style>
    :root{
      --bg:#f3efe5;--card:#fff;--soft:#fbfaf5;--text:#1f2a1f;--muted:#657065;--border:#d9d0bd;
      --accent:#547a44;--accent2:#315f86;--danger:#a33b2f;--warn:#a86d1e;--ok:#2f7d46;
      --shadow:0 12px 30px rgba(31,42,31,.08);--shadow2:0 18px 45px rgba(31,42,31,.13);--glass:rgba(255,255,255,.72);--gold:#c89538;--cream:#fffaf0;
    }
    *{box-sizing:border-box} body{margin:0;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;background:radial-gradient(circle at top left,#fff8df 0,#f3efe5 34%,#e9eddc 100%);color:var(--text);line-height:1.45}
    header{position:relative;overflow:hidden;background:linear-gradient(135deg,#162917,#38572c 55%,#8a9c5c);color:white;padding:46px 18px 38px;text-align:center}header:before{content:'';position:absolute;inset:-80px;background:radial-gradient(circle at 20% 20%,rgba(255,255,255,.22),transparent 24%),radial-gradient(circle at 80% 10%,rgba(255,226,147,.18),transparent 22%);pointer-events:none} header h1{position:relative;margin:0 0 8px;font-size:clamp(34px,6vw,64px);letter-spacing:-.06em;line-height:.95} header p{position:relative;margin:0;opacity:.92}.hero-badges{position:relative;display:flex;justify-content:center;gap:8px;flex-wrap:wrap;margin-top:16px}.hero-badge{background:rgba(255,255,255,.15);border:1px solid rgba(255,255,255,.28);padding:7px 10px;border-radius:999px;font-size:13px;font-weight:800}
    main{max-width:1520px;margin:0 auto;padding:20px 14px 60px}.top-strip{display:grid;grid-template-columns:1.1fr repeat(4,1fr);gap:12px;margin:-34px 0 16px;position:relative;z-index:4}.top-tile{background:var(--glass);backdrop-filter:blur(14px);border:1px solid rgba(217,208,189,.75);border-radius:18px;padding:14px 16px;box-shadow:var(--shadow)}.top-tile small{display:block;color:var(--muted);font-weight:800;margin-bottom:5px}.top-tile strong{font-size:20px;letter-spacing:-.03em}.jump-row{display:flex;gap:8px;flex-wrap:wrap;align-items:center}.jump-row select{width:220px}.tabs{display:flex;gap:8px;flex-wrap:wrap;position:sticky;top:0;z-index:10;background:rgba(243,239,229,.96);backdrop-filter:blur(8px);padding:10px 0 14px;margin-bottom:12px}
    .tab{border:1px solid var(--border);background:rgba(255,255,255,.86);color:var(--text);border-radius:999px;padding:9px 13px;font-weight:800;cursor:pointer;font-size:13px;transition:.15s}.tab:hover{transform:translateY(-1px);box-shadow:0 6px 16px rgba(31,42,31,.08)}.tab.active{background:var(--accent);border-color:var(--accent);color:white}
    .section{display:none}.section.active{display:block;animation:fadeIn .18s ease-out}@keyframes fadeIn{from{opacity:.25;transform:translateY(4px)}to{opacity:1;transform:none}}.grid{display:grid;grid-template-columns:repeat(12,1fr);gap:16px}.card{background:linear-gradient(180deg,#ffffff,#fffdf8);border:1px solid var(--border);border-radius:22px;padding:20px;box-shadow:var(--shadow);transition:.18s}.card:hover{box-shadow:var(--shadow2);transform:translateY(-1px)}.section-intro{grid-column:span 12;background:linear-gradient(135deg,#f8f4e9,#eef5e8);border:1px solid var(--border);border-radius:22px;padding:18px 20px;box-shadow:var(--shadow)}.section-intro h2{margin-bottom:6px}.section-intro p{margin:0;color:var(--muted)}
    .span-2{grid-column:span 2}.span-3{grid-column:span 3}.span-4{grid-column:span 4}.span-5{grid-column:span 5}.span-6{grid-column:span 6}.span-7{grid-column:span 7}.span-8{grid-column:span 8}.span-12{grid-column:span 12}
    h2{margin:0 0 14px;font-size:20px;letter-spacing:-.02em}h3{margin:20px 0 10px;font-size:16px}.subhead{font-weight:800;color:var(--accent);margin:14px 0 8px}
    label{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:10px 0;color:var(--muted);font-size:14px}label .q{display:inline-flex;align-items:center;justify-content:center;width:18px;height:18px;border-radius:50%;background:#edf3e9;color:var(--accent);font-size:12px;font-weight:900;margin-left:6px;cursor:help}.field-help{display:block;color:#7d8679;font-size:11px;margin:-5px 0 8px;line-height:1.35}.smart-note{display:inline-flex;align-items:center;gap:6px;background:#eef5f0;border:1px solid #bdd5c3;color:#2f5936;border-radius:999px;padding:5px 8px;font-size:11px;font-weight:900;margin-left:6px}.step-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:12px 0 18px}.step-card{background:#fff;border:1px solid var(--border);border-radius:16px;padding:14px}.step-card b{display:block;margin-bottom:5px}.step-card span{display:inline-flex;width:26px;height:26px;align-items:center;justify-content:center;border-radius:999px;background:var(--accent);color:white;font-weight:900;margin-right:6px}.mode-box{background:#fff8e8;border:1px solid #e7c985;border-radius:16px;padding:12px 14px;margin:12px 0;color:#6d4a12;font-size:13px}.preset-panel{background:#f6faf3;border:1px solid #c9dcc2;border-radius:16px;padding:12px 14px;margin-top:10px}.preset-panel b{color:#365a2f}.smart-flash{animation:smartFlash .85s ease-out}@keyframes smartFlash{0%{box-shadow:0 0 0 0 rgba(84,122,68,.45)}100%{box-shadow:0 0 0 8px rgba(84,122,68,0)}}input,select,textarea{width:170px;padding:9px 10px;border-radius:10px;border:1px solid var(--border);font-size:15px;background:#fffdf8;color:var(--text);text-align:right}select,textarea{text-align:left}textarea{width:100%;min-height:88px;resize:vertical}
    input:focus,select:focus,textarea:focus{outline:2px solid rgba(84,122,68,.25);border-color:var(--accent);box-shadow:0 0 0 5px rgba(84,122,68,.08)}input:hover,select:hover,textarea:hover{border-color:#b8ad98}.hint{font-size:12px;color:var(--muted);margin-top:6px}.note{font-size:13px;color:var(--muted);margin-top:12px}.info{background:#eef5f0;border:1px solid #bdd5c3;border-radius:14px;padding:12px 14px;color:#2f5936;font-size:13px}.warn{background:#fff8e8;border:1px solid #e7c985;border-radius:14px;padding:12px 14px;color:#6d4a12;font-size:13px}.dangerbox{background:#fff0ee;border-color:#e3b5af;color:#812c23}.okbox{background:#eef8ef;border-color:#b8d8bc;color:#245d31}
    .metrics{display:grid;grid-template-columns:repeat(5,1fr);gap:12px}.metric{background:linear-gradient(180deg,#fffdf7,#f7f4eb);border:1px solid var(--border);border-radius:18px;padding:16px;min-height:96px;position:relative;overflow:hidden}.metric:after{content:'';position:absolute;right:-22px;top:-22px;width:76px;height:76px;border-radius:50%;background:rgba(84,122,68,.08)}.metric small{display:block;color:var(--muted);margin-bottom:7px}.metric strong{font-size:24px;letter-spacing:-.03em}.metric span{display:block;font-size:12px;color:var(--muted);margin-top:5px}
    .positive{color:var(--ok)}.negative{color:var(--danger)}.blue{color:var(--accent2)}table{width:100%;border-collapse:collapse;margin-top:8px;font-size:14px}th,td{padding:10px 8px;border-bottom:1px solid var(--border);text-align:right;vertical-align:top}th:first-child,td:first-child{text-align:left}tfoot td{font-weight:900;background:var(--soft)}
    .actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:15px}button{border:0;border-radius:13px;padding:10px 14px;background:linear-gradient(135deg,var(--accent),#6f9059);color:white;font-weight:800;cursor:pointer;box-shadow:0 8px 18px rgba(84,122,68,.18)}button:hover{filter:brightness(.95)}button.secondary{background:#e7e1d2;color:var(--text)}button.bluebtn{background:var(--accent2)}button.danger{background:var(--danger)}
    details{border:1px solid var(--border);border-radius:16px;padding:12px 14px;background:var(--soft);margin-top:10px}summary{cursor:pointer;font-weight:900}details[open]{background:#fffdf7}.mini-kpis{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:12px}.mini-kpi{border:1px solid var(--border);border-radius:14px;background:#fff;padding:10px}.mini-kpi small{display:block;color:var(--muted);font-size:11px}.mini-kpi b{font-size:17px}.checklist{padding-left:18px;margin:8px 0}.checklist li{margin:5px 0}.soft-divider{height:1px;background:linear-gradient(90deg,transparent,var(--border),transparent);margin:16px 0}.two{columns:2;column-gap:26px}.scenario-list{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px}.chip{background:#fff;border:1px solid var(--border);border-radius:999px;padding:7px 10px;cursor:pointer;font-size:13px}.is-hidden{display:none!important}.empty-state{grid-column:span 12;background:#fffdf7;border:1px dashed #c9bfa8;border-radius:18px;padding:20px;color:var(--muted);text-align:center}.empty-state b{color:var(--text)}.species-badges{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}.species-badge{background:#eef5f0;border:1px solid #bdd5c3;border-radius:999px;padding:6px 9px;font-size:12px;font-weight:900;color:#2f5936}.animal-card{position:relative}.animal-card:before{content:'🐾';position:absolute;right:16px;top:14px;opacity:.16;font-size:34px}.compact-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:8px}.compact-grid label{margin:6px 0}
    .wizard-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.wizard-card{border:1px solid var(--border);background:var(--soft);border-radius:16px;padding:14px;cursor:pointer;transition:.15s}.wizard-card:hover{transform:translateY(-2px);box-shadow:var(--shadow)}.wizard-card b{display:block;margin-bottom:6px}.wizard-card small{color:var(--muted)}
    .report-box{background:#fff;border:1px solid var(--border);border-radius:18px;padding:22px;line-height:1.55}.report-box h2{margin-top:20px}.report-box ul{margin-top:6px}.score{font-size:46px;font-weight:900;letter-spacing:-.05em}.score.good{color:var(--ok)}.score.mid{color:var(--warn)}.score.bad{color:var(--danger)}
    @media(max-width:1100px){.top-strip{grid-template-columns:repeat(2,1fr);margin-top:-22px}.wizard-grid{grid-template-columns:repeat(2,1fr)}.span-2,.span-3,.span-4,.span-5,.span-6,.span-7,.span-8{grid-column:span 12}.metrics{grid-template-columns:repeat(2,1fr)}}@media(max-width:650px){.top-strip{grid-template-columns:1fr}.wizard-grid{grid-template-columns:1fr}label{display:block}input,select{width:100%;margin-top:6px}.metrics{grid-template-columns:1fr}.tabs{position:static}.two{columns:1}}@media print{.tabs,.actions{display:none}.section{display:block!important;break-inside:avoid}.card{box-shadow:none}body{background:white}}
  </style>
</head>
<body>
<header>
  <h1>AgriPlanner Pro</h1>
  <p>Formulario agricolo universale: pascolo, allevamento, colture, frutteti, bosco, agrivoltaico, strutture, tasse e cashflow</p>

</header>
<main>
  <div class="top-strip">
    <div class="top-tile"><small>Navigazione rapida</small><div class="jump-row"><select id="jumpSelect" onchange="switchTab(this.value)"><option value="sintesi">Sintesi</option><option value="wizard">Scenario guidato</option><option value="azienda">Azienda</option><option value="superfici">Superfici</option><option value="allevamento">Allevamento</option><option value="razze">Animali & specie</option><option value="alimentazione">Alimentazione</option><option value="colture">Colture</option><option value="frutteti">Frutteti</option><option value="bosco">Bosco</option><option value="agrivoltaico">Agrivoltaico</option><option value="strutture">Strutture</option><option value="tasse">Tasse</option><option value="cashflow">Cashflow</option><option value="rischi">Rischi</option><option value="report">Report</option><option value="fonti">Metodo & fonti</option><option value="scenari">Scenari</option></select><button class="secondary" onclick="generateReport(true)">Report</button></div></div>
    <div class="top-tile"><small>Ricavi</small><strong id="topRicavi">€0</strong></div>
    <div class="top-tile"><small>Netto</small><strong id="topNetto">€0</strong></div>
    <div class="top-tile"><small>Score rischio</small><strong id="topScore">-</strong></div>
    <div class="top-tile"><small>Payback</small><strong id="topPayback">-</strong></div>
  </div>
  <nav class="tabs">
    <button class="tab" data-tab="sintesi">Sintesi</button>
    <button class="tab active" data-tab="wizard">Scenario guidato</button>
    <button class="tab" data-tab="azienda">Azienda</button>
    <button class="tab" data-tab="superfici">Superfici</button>
    <button class="tab" data-tab="allevamento">Allevamento</button>
    <button class="tab" data-tab="razze">Animali & specie</button>
    <button class="tab" data-tab="alimentazione">Alimentazione</button>
    <button class="tab" data-tab="colture">Colture</button>
    <button class="tab" data-tab="frutteti">Frutteti</button>
    <button class="tab" data-tab="bosco">Bosco</button>
    <button class="tab" data-tab="agrivoltaico">Agrivoltaico</button>
    <button class="tab" data-tab="strutture">Strutture</button>
    <button class="tab" data-tab="tasse">Tasse</button>
    <button class="tab" data-tab="cashflow">Cashflow</button>
    <button class="tab" data-tab="rischi">Rischi</button>
    <button class="tab" data-tab="report">Report</button>
    <button class="tab" data-tab="fonti">Metodo & fonti</button>
    <button class="tab" data-tab="scenari">Scenari</button>
  </nav>

  <section id="wizard" class="section active">
    <div class="grid">
      <div class="card span-12">
        <h2>Scenario guidato: parti da un modello, poi lavori a mano</h2>
        <p class="note">Questa sezione serve solo per creare una base iniziale. Non è obbligatoria: puoi ignorarla e compilare tutto manualmente.</p>
        <div class="step-grid">
          <div class="step-card"><b><span>1</span>Dati base</b><small>Inserisci ettari, budget, rischio e obiettivo.</small></div>
          <div class="step-card"><b><span>2</span>Scegli modello</b><small>Clicca pascolo, bovini, frutteto, bosco, energia o misto.</small></div>
          <div class="step-card"><b><span>3</span>Correggi i numeri</b><small>Vai nelle sezioni e sostituisci ogni stima con i tuoi dati reali.</small></div>
        </div>
        <div class="mode-box"><b>Importante:</b> parti da una scheda vuota. I numeri compaiono solo se li inserisci tu, scegli uno scenario guidato o carichi l’esempio demo. I preset sono scorciatoie, non verità. Ogni campo resta modificabile.</div>
        <div class="actions"><button onclick="clearProject()">Parti da zero</button><button class="secondary" onclick="loadDemoProject()">Carica esempio demo</button><button class="secondary" onclick="switchTab('sintesi')">Vai alla sintesi</button></div>
        <div class="wizard-grid">
          <div class="wizard-card" onclick="applyWizardPreset('pascolo')"><b>Pascolo estensivo</b><small>Bovini/ovini/capre, foraggi, recinzioni, acqua e carico UBA.</small></div>
          <div class="wizard-card" onclick="applyWizardPreset('carne')"><b>Bovini da carne</b><small>Ingrasso, razze, alimentazione, macello, resa carcassa e vendita.</small></div>
          <div class="wizard-card" onclick="applyWizardPreset('vacca')"><b>Vacca-vitello</b><small>Mandria fattrice, tasso svezzamento, rimonta e capi da comprare.</small></div>
          <div class="wizard-card" onclick="applyWizardPreset('frutteto')"><b>Frutteto</b><small>Rese, impianto, anni improduttivi, raccolta e rischio scarto.</small></div>
          <div class="wizard-card" onclick="applyWizardPreset('bosco')"><b>Bosco</b><small>Legna, castagne, funghi, carbonio, costi forestali e vincoli.</small></div>
          <div class="wizard-card" onclick="applyWizardPreset('agrivoltaico')"><b>Agrivoltaico</b><small>Canone, impianto proprio, energia, O&M e ammortamento.</small></div>
          <div class="wizard-card" onclick="applyWizardPreset('misto')"><b>Azienda mista</b><small>Colture + allevamento + bosco + frutteto + contributi.</small></div>
          <div class="wizard-card" onclick="applyWizardPreset('vendita')"><b>Vendita diretta</b><small>Carne, trasformazione, logistica, marketing, laboratorio e cashflow.</small></div>
        </div>
      </div>
      <div class="card span-6">
        <h2>Impostazioni rapide</h2>
        <label>Superficie totale indicativa ha <input id="wizardHa" type="number" value="25" min="0" step="0.5"></label>
        <label>Budget investimento iniziale € <input id="wizardBudget" type="number" value="50000" min="0" step="1000"></label>
        <label>Propensione al rischio <select id="wizardRischio"><option value="prudente">Prudente</option><option value="medio">Media</option><option value="aggressivo">Aggressiva</option></select></label>
        <label>Obiettivo <select id="wizardObiettivo"><option value="reddito">Reddito annuo</option><option value="patrimonio">Valore patrimoniale</option><option value="cashflow">Cashflow stabile</option><option value="brand">Brand/vendita diretta</option></select></label>
        <label>Modalità preset <select id="smartMode"><option value="manuale">Manuale: le tendine non toccano i numeri</option><option value="assistita">Assistita: le tendine aggiornano i valori collegati</option></select></label>
        <div class="preset-panel"><b>Come funziona ora</b><p class="hint">In manuale, cambiare “Angus”, “Biologico” o “Ciliegio” non modifica i campi economici. In assistita, invece, la tendina aggiorna automaticamente costi, rese e ricavi collegati. Puoi anche premere il pulsante qui sotto quando vuoi applicare i preset una sola volta.</p><div class="actions"><button class="secondary" onclick="applyAllSelectedPresets()">Applica preset dalle tendine attuali</button></div></div>
      </div>
      <div class="card span-6">
        <h2>Consiglio automatico</h2>
        <div id="wizardAdvice" class="info">Scegli un progetto per ricevere un consiglio operativo.</div>
      </div>
    </div>
  </section>

  <section id="sintesi" class="section">
    <div class="grid">
      <div class="card span-12">
        <h2>Cruscotto economico generale</h2>
        <div class="metrics">
          <div class="metric"><small>Ricavi annui</small><strong id="outRicavi">€0</strong><span>vendite + contributi + energia</span></div>
          <div class="metric"><small>Costi annui</small><strong id="outCosti">€0</strong><span>operativi + ammortamenti</span></div>
          <div class="metric"><small>Margine lordo</small><strong id="outMargine">€0</strong><span id="outMarginePct">0%</span></div>
          <div class="metric"><small>Utile netto stimato</small><strong id="outNetto">€0</strong><span>dopo tasse impostate</span></div>
          <div class="metric"><small>Payback investimento</small><strong id="outPayback">-</strong><span>anni su utile netto</span></div>
        </div>
        <div id="diagnosi" class="warn"></div>
      </div>
      <div class="card span-6"><h2>Ricavi per area</h2><table><tbody id="tabRicavi"></tbody></table></div>
      <div class="card span-6"><h2>Costi per area</h2><table><tbody id="tabCosti"></tbody></table></div>
      <div class="card span-12"><h2>Indicatori tecnici</h2><table><tbody id="tabIndicatori"></tbody></table><div class="actions"><button onclick="calcola()">Ricalcola</button><button class="secondary" onclick="clearProject()">Svuota progetto</button><button class="secondary" onclick="loadDemoProject()">Carica esempio demo</button><button class="secondary" onclick="window.print()">Stampa / PDF</button></div></div>
    </div>
  </section>

  <section id="azienda" class="section">
    <div class="grid">
      <div class="card span-4"><h2>Profilo azienda</h2>
        <label>Nome scenario <input id="nomeScenario" type="text" value="Scenario agricolo base"></label>
        <label>Regime produttivo <select id="regime"><option value="convenzionale">Convenzionale</option><option value="biologico">Biologico</option><option value="integrato">Produzione integrata</option><option value="biodinamico">Biodinamico</option></select></label>
        <label>Tipo progetto <select id="tipoProgetto"><option value="misto">Misto agricolo-zootecnico</option><option value="solo_allevamento">Solo allevamento</option><option value="solo_colture">Solo colture</option><option value="frutticolo">Frutticolo</option><option value="forestale">Forestale</option><option value="energia">Agrivoltaico/energia</option></select></label>
        <label>Orizzonte analisi anni <input id="anniAnalisi" type="number" value="10" min="1" step="1"></label>
        <label>Inflazione costi %/anno <input id="inflazioneCosti" type="number" value="2.5" min="0" step="0.1"></label>
        <label>Crescita prezzi vendita %/anno <input id="crescitaPrezzi" type="number" value="1.5" min="0" step="0.1"></label>
      </div>
      <div class="card span-4"><h2>Contributi generali</h2>
        <label>PAC base €/ha <input id="pacBaseHa" type="number" value="0" min="0" step="10"></label>
        <label>Premio bio/integrato €/ha <input id="premioRegimeHa" type="number" value="0" min="0" step="10"></label>
        <label>Ecoschemi/pascolo €/ha <input id="ecoHa" type="number" value="0" min="0" step="10"></label>
        <label>Altri contributi annui € <input id="altriContributi" type="number" value="0" min="0" step="100"></label>
        <details><summary>Spiegazione</summary><p class="hint">Inserisci i contributi solo se li conosci o vuoi fare simulazioni. Il calcolatore non verifica automaticamente ammissibilità PAC, titoli, eco-schemi o bandi.</p></details>
      </div>
      <div class="card span-4"><h2>Vendita e canali</h2>
        <label>Canale principale <select id="canaleVendita"><option value="diretta">Vendita diretta</option><option value="grossista">Grossista</option><option value="trasformazione">Trasformazione propria</option><option value="misto">Canale misto</option></select></label>
        <label>Marketing €/anno <input id="marketing" type="number" value="0" min="0" step="100"></label>
        <label>Commerciale/logistica €/anno <input id="logisticaCommerciale" type="number" value="1500" min="0" step="100"></label>
        <label>Perdita/invenduto % <input id="invendutoPct" type="number" value="3" min="0" max="100" step="0.5"></label>
      </div>
    </div>
  </section>

  <section id="superfici" class="section">
    <div class="grid">
      <div class="card span-4"><h2>Superfici principali</h2>
        <label>Seminativi ha <input id="haSeminativi" type="number" value="10" min="0" step="0.1"></label>
        <label>Prati/pascoli ha <input id="haPascoli" type="number" value="10" min="0" step="0.1"></label>
        <label>Bosco ha <input id="haBosco" type="number" value="5" min="0" step="0.1"></label>
        <label>Frutteto ha <input id="haFrutteto" type="number" value="2" min="0" step="0.1"></label>
